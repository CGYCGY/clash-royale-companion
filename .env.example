# Clash Royale developer API token (https://developer.clashroyale.com).
# Tokens are bound to an IP allowlist: create the key for your VPS's public IP.
# Required by the server; the CLI does not need it.
CR_API_TOKEN=

# Base URL of the Clash Royale API. Override to use a proxy such as https://proxy.royaleapi.dev/v1
CR_API_BASE=https://api.clashroyale.com/v1

# SQLite database file. Its directory is created at startup if missing.
DATABASE_PATH=./data/app.db

# HTTP port.
PORT=3000

# Cron pattern for the scheduled sync of all players (default: hourly, on the hour).
SYNC_CRON=0 * * * *

# Minimum seconds between manual syncs of the same player.
SYNC_COOLDOWN_SECONDS=300

# Public base URL, e.g. https://cr.example.com. Optional.
# When it starts with https://, session cookies are marked Secure.
APP_URL=

# Snapshot retention, applied by the daily 04:17 job (or `bun run cli snapshot prune`).
# Every hourly snapshot is kept for SNAPSHOT_KEEP_ALL_DAYS, then one per UTC day until
# SNAPSHOT_KEEP_DAILY_DAYS, then deleted. The newest snapshot of each player is always kept.
SNAPSHOT_KEEP_ALL_DAYS=7
SNAPSHOT_KEEP_DAILY_DAYS=90
