# Clash Royale developer API token (https://developer.clashroyale.com).
# Tokens are bound to an IP allowlist: create the key for your VPS's public IP.
# Required by the server; the CLI does not need it.
CR_API_TOKEN=

# Base URL of the Clash Royale API. Override to use a proxy such as https://proxy.royaleapi.dev/v1
CR_API_BASE=https://api.clashroyale.com/v1

# SQLite database file. Its directory is created at startup if missing.
DATABASE_PATH=./data/app.db

# HTTP port.
PORT=3000

# Cron pattern for the scheduled sync of all players (default: daily at 03:00 server time).
# Set TZ (e.g. TZ=Asia/Kuala_Lumpur) if you want "server time" to be your local time.
SYNC_CRON=0 3 * * *

# Minimum seconds between manual syncs of the same player.
SYNC_COOLDOWN_SECONDS=60

# Public base URL, e.g. https://cr.example.com. Optional.
# When it starts with https://, session cookies are marked Secure.
APP_URL=

# Profile snapshots are kept forever by default. A sync that returns an unchanged profile adds no
# row; it only updates the latest row's last_seen_at. These two settings are opt-in thinning for
# hourly syncs on a small disk, applied by the daily 04:17 job (or `bun run cli snapshot prune`).
# 0 turns a tier off. SNAPSHOT_KEEP_ALL_DAYS > 0: older snapshots are thinned to one per UTC day.
# SNAPSHOT_KEEP_DAILY_DAYS > 0: older snapshots are deleted. The newest snapshot is always kept.
SNAPSHOT_KEEP_ALL_DAYS=0
SNAPSHOT_KEEP_DAILY_DAYS=0
